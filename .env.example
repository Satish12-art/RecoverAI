# RecoverAI Backend
# Mode
RECOVERY_MODE=simulation
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./recoverai.db

# LLM Provider (gemini | openai | anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Razorpay Test Mode (Phase 10)
# RAZORPAY_KEY_ID=key_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=secret_test_xxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=webhook_secret_here

# Policy Engine Thresholds
RECOVERY_PROBABILITY_THRESHOLD=0.60
SCORER_CONFIDENCE_THRESHOLD=0.70
AUTO_RECOVERY_AMOUNT_LIMIT=50000
MAX_RETRIES=2
MAX_LLM_CALLS=3
MAX_AGENT_STEPS=10
AGENT_STEP_TIMEOUT=30

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Frontend
FRONTEND_URL=http://localhost:3000
